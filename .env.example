# Copy to .env for local development. The application reads .env from the working directory.
# Real values belong in the deployment environment, never in the repository.

ENVIRONMENT=development
# Required in production; use a long random value and keep it out of source control.
API_KEY=
DATABASE_URL=postgresql+psycopg://geo:geo@localhost:5432/geo
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=data/uploads

# Upload limits (bytes). Defaults: 100 MiB upload, 500 MiB when a ZIP is expanded, 50 entries.
MAX_UPLOAD_BYTES=104857600
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_ZIP_MEMBERS=50

# Features read, measured and inserted per batch.
PROCESSING_BATCH_SIZE=1000
# Seconds a queued job may run before the worker stops it.
JOB_TIMEOUT_SECONDS=1800
MAX_PROCESSING_ATTEMPTS=3
RECONCILIATION_INTERVAL_SECONDS=15
QUEUE_RETRY_INTERVAL_SECONDS=60
JOB_RECOVERY_GRACE_SECONDS=60
RECONCILIATION_BATCH_SIZE=100

# Production API limits, enforced per client IP using Redis.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
# "json" for production log collectors, "console" for readable local output.
LOG_FORMAT=console

# Used only by docker-compose to create the local database.
POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
