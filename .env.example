# Copy to .env and export the values (for example: set -a; source .env; set +a).
# Every variable is optional; the values below are the defaults.

# SQLAlchemy database URL. Relative SQLite paths resolve from the working directory.
DATABASE_URL=sqlite:///data/app.db

# Largest accepted upload, in bytes (20 MiB).
MAX_UPLOAD_BYTES=20971520

# Largest total size a ZIP archive may expand to, in bytes (100 MiB).
MAX_ZIP_UNCOMPRESSED_BYTES=104857600

# Largest number of entries a ZIP archive may contain.
MAX_ZIP_MEMBERS=50
